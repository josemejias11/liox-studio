generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // pooled (PgBouncer) URL for runtime queries
  directUrl = env("DIRECT_URL")         // direct connection for migrations only
}

// Tracks user sessions
model Session {
  id          String          @id // Browser-generated UUID
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt // Tracks last activity
  progress    LessonProgress[]
  quizzes     QuizAttempt[]
  hotspots    HotspotVisit[]
}

// Tracks per-lesson progress for a session
model LessonProgress {
  sessionId String
  lessonId  String
  courseId  String   @default("")
  completed Boolean  @default(false)
  viewCount Int      @default(1)
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, lessonId])
  @@index([courseId, lessonId])
}

// Normalized Hotspot Visits
model HotspotVisit {
  sessionId String
  lessonId  String
  layerId   String   @default("") // "" if it belongs directly to the lesson
  label     String
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, lessonId, layerId, label])
  @@index([label])
}

// Server-side store for AI-generated quizzes. The full payload (including
// correct answers + explanations) never leaves the server; clients receive a
// stripped projection and grade against this record via /api/quiz/grade.
model GeneratedQuiz {
  id        String   @id @default(cuid())
  payload   String   // JSON: AiQuizResponse (questions incl. correct_answer / explanation)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Records the latest quiz attempt per (session, quiz) — re-submitting the same
// quiz upserts rather than inserting a duplicate row. `quizId` is the
// GeneratedQuiz.id for AI quizzes or the Sanity document _id for CMS quizzes.
// Legacy rows (pre-quizId) were backfilled with their own `id` as quizId so
// the unique constraint holds without dropping history.
model QuizAttempt {
  id        String   @id @default(cuid())
  sessionId String
  quizId    String   @default("")
  courseId  String
  score     Int
  total     Int
  passed    Boolean  @default(false)
  answers   String   // JSON
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, quizId])
  @@index([sessionId])
  @@index([sessionId, passed])
  @@index([createdAt])
}

enum BackgroundJobKind {
  DOCUMENT_INDEX
  QUIZ_GENERATE
  AI_OPERATION
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// Durable queue record. `dedupeKey` is unique only while a job is active; it is
// cleared when the job reaches a terminal state so a later request can enqueue
// fresh work for the same document or quiz input.
model BackgroundJob {
  id             String              @id @default(cuid())
  kind           BackgroundJobKind
  status         BackgroundJobStatus @default(QUEUED)
  dedupeKey      String?             @unique
  payload        Json
  progress       String?
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  runAfter       DateTime            @default(now())
  leaseExpiresAt DateTime?
  leaseToken     String?
  startedAt      DateTime?
  completedAt    DateTime?
  result         Json?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  artifact       JobArtifact?

  @@index([status, runAfter])
  @@index([leaseExpiresAt])
  @@index([completedAt])
}

// Uploaded bytes live with the queued job until document indexing succeeds,
// making the work recoverable across web/worker process restarts.
model JobArtifact {
  id          String        @id @default(cuid())
  jobId       String        @unique
  filename    String
  contentType String?
  bytes       Bytes
  createdAt   DateTime      @default(now())
  job         BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
