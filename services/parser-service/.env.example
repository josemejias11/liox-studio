# Must exactly match the root .env.local PARSER_SERVICE_TOKEN.
PARSER_SERVICE_TOKEN=<shared-internal-token>
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_DIR=./chroma_db
# Set to "true" only when you have a real OPENAI_API_KEY and want to pay for
# embeddings + AI drafting. Defaults to "false" (free local extraction only).
EMBEDDINGS_ENABLED=false
# Where extracted-but-not-embedded chunk text is stored locally when
# EMBEDDINGS_ENABLED is false. Optional; defaults to ./extracted_chunks.
EXTRACTED_DIR=./extracted_chunks
OPENAI_TIMEOUT_SECONDS=120
RELEVANCE_THRESHOLD=0.45
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# PARSER_PORT=8000   # override only if 8000 is taken; do NOT use PORT (collides with Node)
# In-process LRU cache size for per-course Chroma vectorstore wrappers. Optional; defaults to 50.
VECTORSTORE_CACHE_SIZE=50
