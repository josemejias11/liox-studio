# Must exactly match the root .env.local PARSER_SERVICE_TOKEN.
PARSER_SERVICE_TOKEN=<shared-internal-token>
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
EMBEDDING_MODEL=nomic-embed-text
CHROMA_DIR=./chroma_db
OLLAMA_TIMEOUT_SECONDS=120
RELEVANCE_THRESHOLD=0.45
RETRIEVAL_K_CHAT=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# PARSER_PORT=8000   # override only if 8000 is taken; do NOT use PORT (collides with Node)
