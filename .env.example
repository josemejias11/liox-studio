# Copy this file to .env. It contains the values Prisma must load directly and
# non-secret local service defaults. Keep the resulting .env file out of git.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Both URLs point to the same local instance in dev — no pooler needed.
# In production use the pooled URL for DATABASE_URL and the direct URL for
# DIRECT_URL; add ?pgbouncer=true&connection_limit=1 to DATABASE_URL.
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/lb_studio_dev"
DIRECT_URL="postgresql://<user>:<password>@localhost:5432/lb_studio_dev"

# ── Parser service location ──────────────────────────────────────────────────
PARSER_SERVICE_URL="http://localhost:8000"

# ── Background job worker ───────────────────────────────────────────────────
JOB_WORKER_POLL_INTERVAL_MS="1000"

# Absolute path to packages/scorm-export (the package directory containing a
# dist/ subfolder with player.js and player.css) after that package's `build`
# script has run. Required for the job worker to process SCORM_EXPORT jobs;
# without it, exports fail with a "not fully configured" error.
SCORM_PLAYER_BUNDLE_PATH="/absolute/path/to/packages/scorm-export"
