# Copy this file to .env.local and replace every placeholder.
# Next.js and the job worker load it before .env. Never commit .env.local.

# Keep authoring and analytics credentials independent.
COURSE_STUDIO_PASSWORD="<strong-authoring-password>"
ANALYTICS_PASSWORD="<strong-analytics-password>"

# Must exactly match services/parser-service/.env PARSER_SERVICE_TOKEN.
PARSER_SERVICE_TOKEN="<shared-internal-token>"

# Local filesystem root for course assets, source files, and SCORM exports.
# Must be readable/writable by both the web app and the job worker.
LOCAL_STORAGE_ROOT="<absolute-path-to-storage-directory>"
