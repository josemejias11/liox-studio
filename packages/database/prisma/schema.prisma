generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) URL for runtime queries
  directUrl = env("DIRECT_URL") // direct connection for migrations only
}

// ── App-owned course authoring ──────────────────────────────────────────────
//
// Course and lesson identity use caller-provided String IDs so revisions retain
// stable progress references across the authoring and learner surfaces.

enum CourseRevisionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  ARCHIVED
}

enum CourseFeedbackStatus {
  OPEN
  RESOLVED
}

enum CourseSourceIndexStatus {
  PENDING
  INDEXED
  FAILED
  DELETING
}

enum CourseGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum CourseAssistantQaStatus {
  DRAFT
  APPROVED
}

model Course {
  id                         String                @id
  slug                       String                @unique
  title                      String
  description                String?
  createdFromTemplateKey     String?
  createdFromTemplateVersion Int?
  templateChecklist          Json?
  creationJobId              String?               @unique
  duplicatedFromCourseId     String?
  learningObjectives         Json?
  cover                      Json?
  specifications             Json?
  disclaimer                 Json?
  finalQuizId                String?               @unique
  chapters                   CourseChapter[]
  quizzes                    CourseQuiz[]          @relation("CourseQuizzes")
  finalQuiz                  CourseQuiz?           @relation("CourseFinalQuiz", fields: [finalQuizId], references: [id], onDelete: SetNull)
  trashItems                 CourseLessonTrash[]
  revisions                  CourseRevision[]
  sourceFiles                CourseSourceFile[]
  sourceBindings             CourseSourceBinding[]
  assistantQa                CourseAssistantQa[]
  generatedBy                CourseGeneration?     @relation("GeneratedCourse")
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
}

model CourseChapter {
  id                String         @id
  courseId          String
  title             String
  position          Int
  estimatedDuration Int?
  quickCheckId      String?        @unique
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons           CourseLesson[]
  quickCheck        CourseQuiz?    @relation("ChapterQuickCheck", fields: [quickCheckId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([courseId, position])
  @@index([courseId])
}

model CourseLesson {
  id         String        @id
  chapterId  String
  position   Int
  lessonType String
  headline   String
  body       Json?
  payload    Json          @default("{}")
  chapter    CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([chapterId, position])
  @@index([chapterId])
}

model CourseLessonTrash {
  id           String   @id @default(cuid())
  courseId     String
  lessonId     String
  chapterId    String
  chapterTitle String
  position     Int
  lessonType   String
  headline     String
  body         Json?
  payload      Json
  deletedAt    DateTime @default(now())
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, deletedAt])
  @@index([courseId, lessonId])
}

// Course quizzes remain separately addressable because server-side grading
// receives their IDs. Their editable question/answer structure is stored as
// JSON to preserve every authored quiz shape without leaking answer keys.
model CourseQuiz {
  id                String         @id
  courseId          String
  title             String?
  instructions      String?
  payload           Json           @default("{}")
  course            Course         @relation("CourseQuizzes", fields: [courseId], references: [id], onDelete: Cascade)
  chapterQuickCheck CourseChapter? @relation("ChapterQuickCheck")
  finalForCourse    Course?        @relation("CourseFinalQuiz")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([courseId])
}

// Local filesystem storage owns the bytes. This table is the durable
// application inventory for asset identity, object location, and delivery
// metadata.
model CourseAsset {
  id          String   @id @default(cuid())
  r2Key       String   @unique
  filename    String
  contentType String?
  byteSize    Int?
  deliveryUrl String   @map("publicUrl")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Local filesystem storage owns source bytes. This table is the course-scoped
// inventory and indexing lifecycle for those bytes; revisions copy the
// immutable file identity they use.
model CourseSourceFile {
  id             String                  @id @default(cuid())
  courseId       String
  r2Key          String                  @unique
  filename       String
  contentType    String
  byteSize       Int
  sha256         String
  indexStatus    CourseSourceIndexStatus @default(PENDING)
  chunksStored   Int?
  indexError     String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  course         Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  revisionLinks  CourseRevisionSource[]
  courseBindings CourseSourceBinding[]

  @@index([courseId, indexStatus])
  @@index([courseId, createdAt])
}

// A course can inherit an immutable source identity without copying the
// stored file. Generated drafts use this binding to retain the exact frozen
// source set used to create them while the source file remains owned by its
// origin.
model CourseSourceBinding {
  courseId     String
  sourceFileId String
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceFile   CourseSourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)

  @@id([courseId, sourceFileId])
  @@index([sourceFileId])
}

// A revision is an immutable learner-ready snapshot used for client review and
// approval. A later localization/export adapter will consume approved revisions
// without changing the authoring graph or review history.
model CourseRevision {
  id          String                 @id @default(cuid())
  courseId    String
  sourceHash  String
  sourceTitle String
  version     Int
  status      CourseRevisionStatus   @default(DRAFT)
  snapshot    Json
  notes       String?
  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime               @default(now())
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  review      CourseReview?
  sources     CourseRevisionSource[]
  generations CourseGeneration[]
  scormExports CourseScormExport[]
  assistantSnapshot CourseRevisionAssistantQa[]

  @@unique([courseId, version])
  @@unique([courseId, sourceHash])
  @@index([courseId, createdAt])
}

model CourseAssistantQa {
  id               String                  @id @default(cuid())
  courseId         String
  questionVariants Json
  matchingKeywords Json
  approvedAnswer   String
  citations        Json
  status           CourseAssistantQaStatus @default(DRAFT)
  sourceIds        Json
  sourceHashes     Json
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, status, updatedAt])
}

model CourseRevisionAssistantQa {
  revisionId       String
  assistantQaId    String
  questionVariants Json
  matchingKeywords Json
  approvedAnswer   String
  citations        Json
  revision         CourseRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@id([revisionId, assistantQaId])
}

// This is the immutable source binding for a frozen revision. The copied hash
// and filename continue to identify the reviewed source even if the live record
// is later renamed or reindexed.
model CourseRevisionSource {
  revisionId   String
  sourceFileId String
  sha256       String
  filename     String
  revision     CourseRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  sourceFile   CourseSourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)

  @@id([revisionId, sourceFileId])
}

// A generation is durable work provenance, not a partially-created course.
// The course relation becomes populated only after a validated graph is written.
model CourseGeneration {
  id                    String                 @id @default(cuid())
  jobId                 String                 @unique
  sourceRevisionId      String
  brief                 String
  promptTemplateVersion String
  requestedSourceIds    Json
  requestedSourceHashes Json
  modelIdentifier       String?
  status                CourseGenerationStatus @default(QUEUED)
  result                Json?
  error                 String?
  createdCourseId       String?                @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  job                   BackgroundJob          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  sourceRevision        CourseRevision         @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  createdCourse         Course?                @relation("GeneratedCourse", fields: [createdCourseId], references: [id], onDelete: Restrict)

  @@index([sourceRevisionId, createdAt])
  @@index([status, createdAt])
}

// Durable record of one SCORM export artifact for a frozen revision. Kept
// separate from the BackgroundJob row itself, same pattern as CourseGeneration,
// so the export's identity (and its storage location) survives independent of
// job retention/cleanup.
model CourseScormExport {
  id         String         @id @default(cuid())
  revisionId String
  jobId      String         @unique
  r2Key      String
  byteSize   Int
  sha256     String
  createdAt  DateTime       @default(now())
  revision   CourseRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  job        BackgroundJob  @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([revisionId, createdAt])
}

// A review link grants read-only access to exactly one immutable revision.
// The token is stored only as a hash so the original review URL cannot be
// reconstructed from the database.
model CourseReview {
  id              String                 @id @default(cuid())
  revisionId      String                 @unique
  accessTokenHash String                 @unique
  expiresAt       DateTime?
  createdAt       DateTime               @default(now())
  revision        CourseRevision         @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  feedback        CourseReviewFeedback[]
}

model CourseReviewFeedback {
  id         String               @id @default(cuid())
  reviewId   String
  lessonId   String?
  anchor     Json?
  authorName String
  message    String
  status     CourseFeedbackStatus @default(OPEN)
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?
  review     CourseReview         @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, status, createdAt])
}

// Tracks user sessions
model Session {
  id        String           @id // Browser-generated UUID
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt // Tracks last activity
  progress  LessonProgress[]
  quizzes   QuizAttempt[]
  hotspots  HotspotVisit[]
}

// Tracks per-lesson progress for a session
model LessonProgress {
  sessionId String
  lessonId  String
  courseId  String   @default("")
  completed Boolean  @default(false)
  viewCount Int      @default(1)
  updatedAt DateTime @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, lessonId])
  @@index([courseId, lessonId])
}

// Normalized Hotspot Visits
model HotspotVisit {
  sessionId String
  lessonId  String
  layerId   String   @default("") // "" if it belongs directly to the lesson
  label     String
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, lessonId, layerId, label])
  @@index([label])
}

// Server-side store for AI-generated quizzes. The full payload (including
// correct answers + explanations) never leaves the server; clients receive a
// stripped projection and grade against this record via /api/quiz/grade.
model GeneratedQuiz {
  id        String   @id @default(cuid())
  payload   String // JSON: AiQuizResponse (questions incl. correct_answer / explanation)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Records the latest quiz attempt per (session, quiz) — re-submitting the same
// quiz upserts rather than inserting a duplicate row. `quizId` is the
// GeneratedQuiz.id for AI quizzes or CourseQuiz.id for authored quizzes.
// Legacy rows (pre-quizId) were backfilled with their own `id` as quizId so
// the unique constraint holds without dropping history.
model QuizAttempt {
  id        String   @id @default(cuid())
  sessionId String
  quizId    String   @default("")
  courseId  String
  score     Int
  total     Int
  passed    Boolean  @default(false)
  answers   String // JSON
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, quizId])
  @@index([sessionId])
  @@index([sessionId, passed])
  @@index([createdAt])
}

enum BackgroundJobKind {
  DOCUMENT_INDEX
  QUIZ_GENERATE
  AI_OPERATION
  SCORM_EXPORT
  COURSE_DUPLICATE
}

enum BackgroundJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// Durable queue record. `dedupeKey` is unique only while a job is active; it is
// cleared when the job reaches a terminal state so a later request can enqueue
// fresh work for the same document or quiz input.
model BackgroundJob {
  id             String              @id @default(cuid())
  kind           BackgroundJobKind
  status         BackgroundJobStatus @default(QUEUED)
  dedupeKey      String?             @unique
  payload        Json
  progress       String?
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  runAfter       DateTime            @default(now())
  leaseExpiresAt DateTime?
  leaseToken     String?
  startedAt      DateTime?
  completedAt    DateTime?
  result         Json?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  artifact       JobArtifact?
  generation     CourseGeneration?
  scormExport    CourseScormExport?

  @@index([status, runAfter])
  @@index([leaseExpiresAt])
  @@index([completedAt])
}

// Uploaded bytes live with the queued job until document indexing succeeds,
// making the work recoverable across web/worker process restarts.
model JobArtifact {
  id          String        @id @default(cuid())
  jobId       String        @unique
  filename    String
  contentType String?
  bytes       Bytes
  createdAt   DateTime      @default(now())
  job         BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
