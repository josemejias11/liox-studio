{
  "name": "moto-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-workspace.mjs @moto-ai/web dev",
    "jobs:worker": "node scripts/run-workspace.mjs @moto-ai/job-worker dev",
    "build": "npm run db:migrate && node scripts/run-workspace.mjs @moto-ai/web build",
    "start": "node scripts/run-workspace.mjs @moto-ai/web start",
    "lint": "eslint apps packages scripts",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "npm run db:generate",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@next/env": "^16.2.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^5.22.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
