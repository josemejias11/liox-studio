generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tracks user sessions
model Session {
  id          String          @id // Browser-generated UUID
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt // Tracks last activity
  progress    SlideProgress[]
  quizzes     QuizAttempt[]
  hotspots    HotspotVisit[]
}

// Tracks per-slide progress for a session
model SlideProgress {
  sessionId       String
  slideId         String
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, slideId])
}

// Normalized Hotspot Visits
model HotspotVisit {
  sessionId String
  slideId   String
  label     String
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, slideId, label])
  @@index([label])
}

// Records each quiz attempt for a session
model QuizAttempt {
  id        String   @id @default(cuid())
  sessionId String
  moduleId  String
  score     Int
  total     Int
  answers   String   // JSON
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@index([createdAt])
}
