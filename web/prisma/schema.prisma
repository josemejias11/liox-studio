generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tracks user sessions
model Session {
  id          String          @id // Browser-generated UUID
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt // Tracks last activity
  progress    LessonProgress[]
  layerProg   LayerProgress[]
  quizzes     QuizAttempt[]
  hotspots    HotspotVisit[]
}

// Tracks per-lesson progress for a session
model LessonProgress {
  sessionId       String
  lessonId        String
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, lessonId])
}

// Tracks per-layer progress for a session
model LayerProgress {
  sessionId       String
  lessonId        String
  layerId         String
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, lessonId, layerId])
}

// Normalized Hotspot Visits
model HotspotVisit {
  sessionId String
  lessonId  String
  layerId   String   @default("") // "" if it belongs directly to the lesson
  label     String
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, lessonId, layerId, label])
  @@index([label])
}

// Server-side store for AI-generated quizzes. The full payload (including
// correct answers + explanations) never leaves the server; clients receive a
// stripped projection and grade against this record via /api/quiz/grade.
model GeneratedQuiz {
  id        String   @id @default(cuid())
  payload   String   // JSON: AiQuizResponse (questions incl. correct_answer / explanation)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Records each quiz attempt for a session
model QuizAttempt {
  id        String   @id @default(cuid())
  sessionId String
  courseId  String
  score     Int
  total     Int
  passed    Boolean  @default(false)
  answers   String   // JSON
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@index([sessionId, passed])
  @@index([createdAt])
}
