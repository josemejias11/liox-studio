# Copy this file to .env.local and fill in the secret values.
# .env already contains safe local defaults — only secrets need to go in .env.local.
#
# ── PostgreSQL (local dev) ───────────────────────────────────────────────────
# Both URLs point to the same local instance in dev — no pooler needed.
# In production use the pooled URL for DATABASE_URL and the direct URL for
# DIRECT_URL; add ?pgbouncer=true&connection_limit=1 to DATABASE_URL.
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/moto_ai_dev"
DIRECT_URL="postgresql://<user>:<password>@localhost:5432/moto_ai_dev"

# ── Sanity CMS ───────────────────────────────────────────────────────────────
# Public identifiers — already set in .env. Only override here if using a
# different Sanity project.
NEXT_PUBLIC_SANITY_PROJECT_ID="e7l925v5"
NEXT_PUBLIC_SANITY_DATASET="production"

# Secret — get from sanity.io/manage → your project → API → Tokens → Add token
# (Editor role). Required for Studio mutations; read-only content works without it.
SANITY_API_TOKEN="<your-sanity-editor-token>"

# ── FastAPI parser / RAG service ─────────────────────────────────────────────
# Dev: local Ollama running via FastAPI at http://localhost:8000
# Prod: replace with the hosted service URL.
PARSER_SERVICE_URL="http://localhost:8000"
# Shared secret between Next.js and the FastAPI service (X-Internal-Token header).
PARSER_SERVICE_TOKEN="<shared-secret>"

# ── Upstash Redis — rate limiting (optional in dev) ──────────────────────────
# Leave empty locally — rate limiting is gracefully disabled when unset.
# Provision a Redis DB at https://console.upstash.com for production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Analytics dashboard ───────────────────────────────────────────────────────
# Any non-empty string unlocks the dashboard locally.
# Use a strong random secret (e.g. openssl rand -hex 32) in production.
ANALYTICS_PASSWORD="change-me"
